# ── Google OAuth credentials (NEVER commit these) ───────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-long-lived-refresh-token

# ── Server Transport ─────────────────────────────────────────────────────────
# Options: stdio (default, for local agents) | sse (for remote/HTTP agents)
MCP_TRANSPORT=stdio

# ── HTTP/SSE Transport ───────────────────────────────────────────────────────
# Only required when MCP_TRANSPORT=sse
PORT=3000

# ── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
